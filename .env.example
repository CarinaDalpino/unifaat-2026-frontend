POSTGRES_HOST=localhost
POSTGRES_DB=unifaat
POSTGRES_PORT=6789
POSTGRES_USER=
POSTGRES_PASSWORD=

NGNIX_WEB_PORT=8080
NGINX_PORT=80
NODE_WEB_PORT=3000

RABBITMQ_USER=
RABBITMQ_PASSWORD=

JWT_SECRET=

# IP do seu PC na rede (hostname -I): o chat mostra esse IP para quem conecta do PRÓPRIO PC (sem isso aparece o gateway do Docker)
HOST_LAN_IP=

# Segredo do professor para ligar/desligar o cache (POST /api/admin/cache, header x-admin-token)
ADMIN_TOKEN=

# Portas publicadas no host (padrões se ficarem vazias: Grafana 3002, Prometheus 9090) e senha do admin do Grafana
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin
